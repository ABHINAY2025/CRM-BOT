# ---- WhatsApp Cloud API ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=choose_any_random_string
GRAPH_VERSION=v23.0

# ---- Server ----
PORT=3000

# ---- ngrok ----
# Start ngrok automatically with the server and show the https URL in Settings
NGROK_AUTOSTART=false
# Optional: otherwise the authtoken from your ngrok config file is used
NGROK_AUTHTOKEN=
# Optional: your free static ngrok domain (e.g. my-crm.ngrok-free.app) so the URL never changes
NGROK_DOMAIN=
# Automatically point the Meta app's webhook to the current ngrok URL on startup
AUTO_REGISTER_WEBHOOK=true

# ---- AI bot (Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=medium

# ---- Database (MongoDB Atlas) ----
MONGO_URI=

# ---- CRM login (required on Vercel) ----
CRM_PASSWORD=
SESSION_SECRET=
