{
  "name": "whatsapp-crm-bot",
  "version": "1.0.0",
  "description": "WhatsApp Cloud API CRM with bot automations, Jira-style dashboard and ngrok webhook tunnel",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "setup": "npm install && npm --prefix web install && npm --prefix web run build",
    "build": "npm --prefix web run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "npm --prefix web run dev",
    "tunnel": "node tunnel.js",
    "bot": "node start.js",
    "migrate": "node scripts/migrate-json-to-mongo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@ngrok/ngrok": "^1.7.0",
    "@vercel/functions": "^3.11.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^7.9.0"
  }
}
